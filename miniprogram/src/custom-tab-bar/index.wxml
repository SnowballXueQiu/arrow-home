<view class="custom-tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="path"
    class="tab-item {{selected === index ? 'tab-item--active' : ''}}"
    data-path="{{item.path}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image
      class="tab-icon"
      src="./icons/{{selected === index ? item.activeIcon : item.icon}}.png"
      mode="aspectFit"
    />
  </view>
</view>
