.custom-tab-bar {
  display: flex;
  height: 144rpx;
  padding: 18rpx 76rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fff;
  border-top: 1rpx solid rgba(25, 34, 31, .08);
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.tab-icon {
  width: 72rpx;
  height: 72rpx;
  transform: translateY(6rpx);
}
